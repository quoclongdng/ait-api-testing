# Docker Compose settings (copied to .env by `make setup`). Never commit .env.
POSTGRES_DB=ait
POSTGRES_USER=ait
POSTGRES_PASSWORD=change-me-local-only
# POSTGRES_PORT, AI_SERVICE_PORT (and Ollama 11434) are published on 127.0.0.1 only.
POSTGRES_PORT=5433
WEB_PORT=8000
AI_SERVICE_PORT=8001
BENCHMARK_PORT=8002
BENCHMARK_ORDER_PORT=8003
BENCHMARK_BOOKING_PORT=8004
# make experiment / make up-experiment (S12-02) export these for docker/docker-compose.experiment-llm.yml;
# set them here only to change the defaults of a manual `make up-experiment`.
# EXPERIMENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# EXPERIMENT_LLM_CONTEXT_TOKENS=16384
# EXPERIMENT_MODEL=qwen2.5-coder:7b
# EXPERIMENT_TEMPERATURE=0.2
# EXPERIMENT_SEEDS=42,1024,2026
# EXPERIMENT_RESET_PER_CASE=true
# EXPERIMENT_LLM_TIMEOUT_SECONDS=300
# EXPERIMENT_GENERATE_BUDGET_SECONDS=1320
# EXPERIMENT_AI_SERVICE_TIMEOUT=1380
# EXPERIMENT_LLM_CASES_PER_CALL=3
