APP_NAME="AI Testing Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
# Múi giờ hiển thị thời gian trên UI và file xuất (dữ liệu vẫn lưu theo UTC)
APP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ait
DB_USERNAME=ait
DB_PASSWORD=change-me-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=ait_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout (RunExperimentStepJob: 1500 s) and the worker --timeout (1800 s)
DB_QUEUE_RETRY_AFTER=1900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Testing Platform (docs/DESIGN.md §7) ---
AI_SERVICE_DRIVER=http
AI_SERVICE_URL=http://ai-service:8001
# Seconds for one POST /v1/generate: ai-service AI_GENERATE_BUDGET_SECONDS (1320) + 60, below
# GenerateTestsJob / RunExperimentStepJob timeouts (1500 s) (S11-02).
AI_SERVICE_TIMEOUT=1380
TARGET_CLIENT_DRIVER=http
TARGET_DEFAULT_TIMEOUT_MS=10000
# Benchmark sandboxes inside Docker (S12-02): clean aliases + one host per seeded bug.
# Regenerate the list with: python benchmark/tools/gen_variant_compose.py --print-allowlist
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,benchmark,benchmark-order,benchmark-booking,appointment-booking,appointment-booking-bug-023,appointment-booking-bug-024,appointment-booking-bug-025,appointment-booking-bug-026,appointment-booking-bug-027,appointment-booking-bug-028,appointment-booking-bug-029,appointment-booking-bug-030,appointment-booking-bug-031,appointment-booking-bug-032,ecommerce-order,ecommerce-order-bug-011,ecommerce-order-bug-012,ecommerce-order-bug-013,ecommerce-order-bug-014,ecommerce-order-bug-015,ecommerce-order-bug-016,ecommerce-order-bug-017,ecommerce-order-bug-018,ecommerce-order-bug-019,ecommerce-order-bug-020,ecommerce-order-bug-021,ecommerce-order-bug-022,simple-store,simple-store-bug-001,simple-store-bug-002,simple-store-bug-003,simple-store-bug-004,simple-store-bug-005,simple-store-bug-006,simple-store-bug-007,simple-store-bug-008,simple-store-bug-009,simple-store-bug-010
# Benchmark sandboxes for experiments M14/M15 (S9-02)
# BENCHMARK_PATH=../benchmark
BENCHMARK_SANDBOX_DRIVER=url_template
# Single-bug sandbox base URL (placeholders: {slug} {version} {code} {code_lower} {toggle} {base_url}).
# Matches docker/docker-compose.experiment.yml (make up-experiment), e.g. http://simple-store-bug-001:8000.
# Clean variant = benchmark base_url from ground-truth.yaml = http://<slug>:8000 (e.g. http://simple-store:8000).
BENCHMARK_VARIANT_URL_TEMPLATE=http://{slug}-{code_lower}:8000
# Password for the bootstrap ADMIN (admin@ait.local) created by make fresh / make seed.
# Empty = the seeder generates a random password and prints it once. Never use a well-known value.
ADMIN_DEFAULT_PASSWORD=
# Password for the demo TESTER (demo@ait.local) created by make demo / make demo-seed (S14-01).
# Empty = the seeder generates a random password and prints it once. Never commit a real value.
DEMO_PASSWORD=
# Clean-variant base URL reachable from the worker (placeholders: {slug} {version} {base_url}; empty = benchmark base_url)
BENCHMARK_CLEAN_URL_TEMPLATE=http://{slug}:8000
BENCHMARK_RESET_TIMEOUT_MS=10000
# Per-repetition seeds of the experiment protocol (experiment-design.md §4.2)
EXPERIMENT_SEEDS=42,1024,2026
# Reset the benchmark sandbox before every test case of an experiment run (ADR-0006 addendum 2026-10-12)
EXPERIMENT_RESET_PER_CASE=true
# M12 runs on these benchmark hosts reset the sandbox before every test case; other targets are never reset
# (empty = M12 never resets; ADR-0006 addendum 2026-10-13)
RUN_RESET_BENCHMARK_HOSTS=benchmark,benchmark-order,benchmark-booking,simple-store,ecommerce-order,appointment-booking
# --- Production profile (ADR-0007). Local defaults below. ---
# false = no single-bug sandboxes on this deployment: M15 / POST /api/v1/experiments refuse new experiments.
EXPERIMENTS_ENABLED=true
# Showcase demo công khai (S14-05, ADR-0007 bổ sung 2026-10-13): true = php artisan ait:demo:showcase tạo/khôi phục
# 4 tài khoản demo CÔNG KHAI (admin@demo.ait.local, tester@/tester2@/tester3@demo.ait.local, mật khẩu 123456) và dữ liệu mẫu;
# trang đăng nhập liệt kê các tài khoản này. Chỉ bật trên site demo.
DEMO_SHOWCASE_ENABLED=false
# Reverse proxies whose X-Forwarded-* headers are trusted: empty = none (local), * = the calling hop
# (server: host nginx, port bound to 127.0.0.1 only), or a list of IP/CIDR plus the keyword cloudflare.
# CF-Connecting-IP is honoured only via a trusted proxy whose peer is a Cloudflare edge.
TRUSTED_PROXIES=
# Refuse loopback/private addresses for targets added in M04 (default: true when APP_ENV=production).
# TARGET_BLOCK_PRIVATE_NETWORKS=false
# Security headers (CSP with nonce, X-Frame-Options, nosniff...) and HSTS max-age on HTTPS (0 = off).
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# Login throttling: failed attempts per email+IP per minute, per IP across emails per LOGIN_IP_DECAY_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_IP_DECAY_SECONDS=600
# Per-user burst/hourly limits of expensive actions (generation jobs, runs, experiments, spec uploads).
# RATE_LIMIT_GENERATION_PER_MINUTE=10
# RATE_LIMIT_GENERATION_PER_HOUR=60
# RATE_LIMIT_TEST_RUNS_PER_MINUTE=10
# RATE_LIMIT_TEST_RUNS_PER_HOUR=120
# RATE_LIMIT_EXPERIMENTS_PER_MINUTE=10
# RATE_LIMIT_EXPERIMENTS_PER_HOUR=20
# RATE_LIMIT_SPEC_UPLOADS_PER_MINUTE=10
# RATE_LIMIT_SPEC_UPLOADS_PER_HOUR=60
