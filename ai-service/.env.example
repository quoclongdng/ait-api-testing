# ai-service settings (docs/DESIGN.md §7). Copy to .env for local overrides.
AI_APP_VERSION=1.0.0
# fake | openai_compatible | disabled (no LLM on this server: only RULE works, ADR-0007)
AI_LLM_PROVIDER=fake
# OpenAI-compatible endpoint: Ollama (http://ollama:11434/v1), vLLM, OpenAI...
# Ollama running natively on the Docker host: http://host.docker.internal:11434/v1
AI_LLM_BASE_URL=http://ollama:11434/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=qwen2.5-coder:7b
# Per-call timeout (seconds) of one chat completion; must be below AI_GENERATE_BUDGET_SECONDS.
AI_LLM_TIMEOUT_SECONDS=300
# HTTP 429/503 của nhà cung cấp (giới hạn tốc độ, ví dụ gói miễn phí): chờ theo Retry-After/x-ratelimit-reset-*
# rồi thử lại tối đa N lần, không vượt thời gian còn lại của lời gọi (0 = không thử lại).
AI_LLM_RATE_LIMIT_RETRIES=3
AI_LLM_TEMPERATURE=0.2
AI_LLM_SEED=42
AI_MAX_REPAIR_ATTEMPTS=2
# Overall time budget (seconds) for one /v1/generate: one GENERATE call per endpoint, then
# repairs while time remains; what is left over is skipped (partial result, job PARTIAL).
# Keep it at least 60 s below web AI_SERVICE_TIMEOUT (1380).
AI_GENERATE_BUDGET_SECONDS=1320
# Cases asked from the model per GENERATE call (one call per endpoint); the effective
# number is min(options.max_cases_per_endpoint, this).
AI_LLM_CASES_PER_CALL=3
# Output tokens budgeted per case: max_tokens = cases * this + 256 (REPAIR: 2 * this + 256).
AI_LLM_OUTPUT_TOKENS_PER_CASE=400
# Max characters of one prompt; ceil(chars/3) + max_tokens must fit AI_LLM_CONTEXT_TOKENS.
AI_MAX_PROMPT_CHARS=36000
# Context window (tokens) of the model: must equal Ollama OLLAMA_CONTEXT_LENGTH / num_ctx
# (the compose ollama service sets 16384). A prompt whose estimate of chars/3 tokens plus
# the call's max_tokens exceeds it is not sent (422 / repair skipped).
# A native Ollama on its 2k-4k default silently drops the prompt head: start it with
# OLLAMA_CONTEXT_LENGTH=16384 ollama serve (or set this to its real context). Provider
# token counts that show a cut prompt are logged as failed calls (502 if all fail).
AI_LLM_CONTEXT_TOKENS=16384
