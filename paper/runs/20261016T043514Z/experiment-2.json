                    {
                        "code": "BR-AB-001",
                        "path": "/departments",
                        "method": "GET",
                        "description": "The department catalog is public (no token needed) and lists every department with id, name, code and description."
                    },
                    {
                        "code": "BR-AB-002",
                        "path": "/departments/{department_id}",
                        "method": "GET",
                        "description": "An unknown department returns 404 with a JSON error body."
                    },
                    {
                        "code": "BR-AB-003",
                        "path": "/doctors",
                        "method": "GET",
                        "description": "The optional department_id filter returns only the doctors of that department."
                    },
                    {
                        "code": "BR-AB-004",
                        "path": "/doctors/{doctor_id}",
                        "method": "GET",
                        "description": "An unknown doctor returns 404; every doctor has a max_daily_quota (the clinic limit is 20 appointments per doctor per day)."
                    },
                    {
                        "code": "BR-AB-005",
                        "path": "/doctors/{doctor_id}/slots",
                        "method": "GET",
                        "description": "The date query must be a real calendar date in YYYY-MM-DD (otherwise 422); a slot that is already booked has is_available false."
                    },
                    {
                        "code": "BR-AB-006",
                        "path": "/appointments",
                        "method": "GET",
                        "description": "A patient sees only their own appointments."
                    },
                    {
                        "code": "BR-AB-007",
                        "path": "/appointments",
                        "method": "POST",
                        "description": "The clinic is closed on Sundays and on the fixed holidays 2026-12-25 and 2026-01-01; booking such a day is rejected with 409."
                    },
                    {
                        "code": "BR-AB-008",
                        "path": "/appointments",
                        "method": "POST",
                        "description": "A doctor cannot have two appointments in the same slot of the same day and accepts at most 20 appointments per day; both conflicts return 409."
                    },
                    {
                        "code": "BR-AB-009",
                        "path": "/appointments/{appointment_id}",
                        "method": "PATCH",
                        "description": "An appointment can be rescheduled only at least 24 hours before it starts (otherwise 409); the sandbox clock is fixed at 2026-10-10T08:00:00Z."
                    },
                    {
                        "code": "BR-AB-010",
                        "path": "/appointments/{appointment_id}",
                        "method": "DELETE",
                        "description": "Cancelling returns 204 and removes the appointment; a patient may cancel only their own appointments (another patient's -> 403) while DOCTOR and ADMIN may cancel any."
                    }
                ],
                "reset_per_case": true
