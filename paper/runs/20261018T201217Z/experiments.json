                "business_rules": [
                    {
                        "code": "BR-SS-001",
                        "path": "/categories",
                        "method": "POST",
                        "description": "Category slugs are unique: creating a category whose slug already exists is rejected with 409."
                    },
                    {
                        "code": "BR-SS-002",
                        "path": "/categories",
                        "method": "GET",
                        "description": "Categories are paginated with limit (1 to 100, default 50) and offset (0 or more); the response is a JSON array of categories."
                    },
                    {
                        "code": "BR-SS-003",
                        "path": "/categories/{id}",
                        "method": "GET",
                        "description": "Reading a category that does not exist returns 404 with a JSON error body."
                    },
                    {
                        "code": "BR-SS-004",
                        "path": "/products",
                        "method": "POST",
                        "description": "A product must reference an existing category (unknown category_id -> 404) and its SKU must be unique (duplicate SKU -> 409)."
                    },
                    {
                        "code": "BR-SS-005",
                        "path": "/products",
                        "method": "GET",
                        "description": "The optional category_id filter returns only the products of that category."
                    },
                    {
                        "code": "BR-SS-006",
                        "path": "/products/{id}",
                        "method": "GET",
                        "description": "Reading a product that does not exist returns 404 with a JSON error body."
                    },
                    {
                        "code": "BR-SS-007",
                        "path": "/products/{id}",
                        "method": "PUT",
                        "description": "Only the fields sent in the body are changed (omitted or null fields keep their value); moving a product to a category that does not exist returns 404."
                    },
                    {
                        "code": "BR-SS-008",
                        "path": "/products/{id}",
                        "method": "DELETE",
                        "description": "A deleted product can no longer be read: a later GET /products/{id} for it returns 404; deleting an unknown product returns 404."
                    }
                ],
                "reset_per_case": true
            },
